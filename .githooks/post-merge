#!/bin/sh
if [ -f .env ] && [ -f vendor/autoload.php ]; then
    php artisan demo:sync-db --no-interaction || {
        echo 'Demo database sync failed. Run php artisan demo:sync-db after fixing the local connection.' >&2
        exit 1
    }
else
    echo 'Demo database sync skipped until .env and Composer dependencies are ready.' >&2
fi
